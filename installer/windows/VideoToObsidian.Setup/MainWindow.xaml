<Window x:Class="VideoToObsidian.Setup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="视知库安装与连接向导" Height="720" Width="980"
        MinHeight="650" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}" Foreground="White">
    <Grid Margin="32">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="235" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource CardBrush}" CornerRadius="18" Padding="24">
            <StackPanel>
                <TextBlock Text="视知库" FontSize="30" FontWeight="SemiBold" />
                <TextBlock Text="Video to Obsidian" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,30" />
                <TextBlock Text="1  准备本机" FontSize="17" Margin="0,10" />
                <TextBlock Text="2  Kimi 连接" FontSize="17" Margin="0,10" />
                <TextBlock Text="3  ZCode 工作区" FontSize="17" Margin="0,10" />
                <TextBlock Text="4  扫码连接" FontSize="17" Margin="0,10" />
                <TextBlock Text="5  免费检查" FontSize="17" Margin="0,10" />
                <Border Background="#222532" CornerRadius="12" Padding="14" Margin="0,28,0,0">
                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"
                               Text="不需要 Coding Plan、Python 或终端知识。安装检查不会调用付费视频分析。" />
                </Border>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="一次安装，以后在微信里发视频" FontSize="30" FontWeight="SemiBold" />
                <TextBlock Text="默认不保存原视频、不生成逐字稿，只把正式笔记写入 Obsidian。"
                           Foreground="{StaticResource MutedBrush}" FontSize="16" Margin="0,8,0,22" />

                <Border Background="{StaticResource CardBrush}" CornerRadius="14" Padding="20" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="1. 准备本机" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Text="自动创建 Obsidian 知识库和专用 ZCode 工作区。" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,10" />
                        <TextBlock Text="Obsidian 知识库" />
                        <TextBox x:Name="VaultPathBox" Margin="0,6,0,8" />
                        <Button x:Name="PrepareButton" Content="准备本机" Click="PrepareButton_Click" HorizontalAlignment="Left" />
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource CardBrush}" CornerRadius="14" Padding="20" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="2. 连接 Kimi" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Text="Key 只保存到系统安全存储，不会显示在日志里。" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,10" />
                        <PasswordBox x:Name="KimiKeyBox" Margin="0,6,0,8" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="保存 Key" Click="SaveKeyButton_Click" />
                            <Button Content="无 Coding Plan：复用该 Key" Click="ConfigureMoonshotButton_Click" Background="#353948" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource CardBrush}" CornerRadius="14" Padding="20" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="3. 扫码连接" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Text="使用专用 Firefox 登录抖音和B站，然后在 ZCode 工作区中连接官方微信 Bot Channel。"
                                   TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,10" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="打开 ZCode Bot Channel 教程" Click="OpenBotGuideButton_Click" />
                            <Button Content="打开专用工作区" Click="OpenWorkspaceButton_Click" Background="#353948" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource CardBrush}" CornerRadius="14" Padding="20">
                    <StackPanel>
                        <TextBlock Text="4. 免费检查" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock x:Name="StatusText" Text="正在检查…" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,8" />
                        <Button Content="重新检查" Click="RefreshButton_Click" HorizontalAlignment="Left" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
