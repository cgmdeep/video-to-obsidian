<Window x:Class="VideoToObsidian.Setup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="视知库安装与连接向导" Height="720" Width="980"
        MinHeight="650" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}" Foreground="White">
    <Grid Margin="32">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="235" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource CardBrush}" CornerRadius="18" Padding="24">
            <StackPanel>
                <TextBlock Text="视知库" FontSize="30" FontWeight="SemiBold" />
                <TextBlock Text="Video to Obsidian" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,30" />
                <TextBlock Text="1  准备本机" FontSize="17" Margin="0,10" />
                <TextBlock Text="2  Kimi 连接" FontSize="17" Margin="0,10" />
                <TextBlock Text="3  视频平台登录" FontSize="17" Margin="0,10" />
                <TextBlock Text="4  微信连接" FontSize="17" Margin="0,10" />
                <TextBlock Text="5  免费检查" FontSize="17" Margin="0,10" />
                <Border Background="#222532" CornerRadius="12" Padding="14" Margin="0,28,0,0">
                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"
                               Text="不需要 Coding Plan、Python 或终端知识。安装检查不会调用付费视频分析。" />
                </Border>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="一次安装，以后在微信里发视频" FontSize="30" FontWeight="SemiBold" />
                <TextBlock Text="默认不保存原视频、不生成逐字稿，只把正式笔记写入 Obsidian。"
                           Foreground="{StaticResource MutedBrush}" FontSize="16" Margin="0,8,0,22" />

                <Border Background="{StaticResource CardBrush}" CornerRadius="14" Padding="20" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="1. 准备本机" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Text="自动创建 Obsidian 知识库和专用 ZCode 工作区；为完成首次登记，运行中的 Obsidian 会保存后重启。" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,10" TextWrapping="Wrap" />
                        <TextBlock Text="Obsidian 知识库" />
                        <TextBox x:Name="VaultPathBox" Margin="0,6,0,8" />
                        <Expander Header="高级设置（可选）" Margin="0,2,0,10">
                            <StackPanel Margin="12,8,0,2">
                                <CheckBox x:Name="TranscriptProfileCheckBox"
                                          Content="启用逐字稿增强版（实验性）" />
                                <TextBlock x:Name="TranscriptProfileHint"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource MutedBrush}"
                                           Margin="0,6,0,0" />
                            </StackPanel>
                        </Expander>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="PrepareButton" Content="安装 / 修复本机" Click="PrepareButton_Click" />
                            <Button Content="用 Obsidian 打开" Click="OpenVaultButton_Click" Background="#353948" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource CardBrush}" CornerRadius="14" Padding="20" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="2. 连接 Kimi" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Text="Key 只保存到系统安全存储。如果 ZCode 还没有模型，会自动复用这个 Key；已有配置完全保留。"
                                   TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,10" />
                        <PasswordBox x:Name="KimiKeyBox" Margin="0,6,0,8" />
                        <Button Content="安全保存并自动补齐" Click="SaveKeyButton_Click" HorizontalAlignment="Left" />
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource CardBrush}" CornerRadius="14" Padding="20" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="3. 登录视频平台" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Text="两个按钮只会打开隔离的 VideoToObsidian Firefox 登录空间；请用自己的账号扫码。"
                                   TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,10" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="登录抖音" Click="OpenDouyinLoginButton_Click" />
                            <Button Content="登录B站" Click="OpenBilibiliLoginButton_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource CardBrush}" CornerRadius="14" Padding="20" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="4. 连接 ZCode 官方微信 Bot" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Text="不用企业微信。安装 ZCode 后选择“视知库助手”目录作为工作区，再按官方教程扫码绑定微信。"
                                   TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,10" />
                        <WrapPanel>
                            <Button Content="安装 / 打开 ZCode" Click="OpenZCodeInstallButton_Click" />
                            <Button Content="官方微信连接教程" Click="OpenBotGuideButton_Click" />
                            <Button Content="用 ZCode 打开视知库助手" Click="OpenWorkspaceInZCodeButton_Click" Background="#353948" />
                            <Button Content="打开工作区文件夹" Click="OpenWorkspaceButton_Click" Background="#353948" />
                            <Button Content="复制工作区路径" Click="CopyWorkspacePathButton_Click" Background="#353948" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource CardBrush}" CornerRadius="14" Padding="20" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="5. 免费检查" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock x:Name="StatusText" Text="正在检查…" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,8" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="重新检查" Click="RefreshButton_Click" />
                            <Button Content="导出脱敏诊断报告" Click="ExportDiagnosticsButton_Click" Background="#353948" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource CardBrush}" CornerRadius="14" Padding="20">
                    <StackPanel>
                        <TextBlock Text="维护" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Text="安全卸载只移除视知库核心和本项目的 ZCode 连接；Obsidian 笔记、登录空间、Kimi Key 和其他软件都会保留。"
                                   TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,10" />
                        <Button Content="安全卸载（保留笔记）" Click="UninstallButton_Click"
                                HorizontalAlignment="Left" Background="#353948" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
