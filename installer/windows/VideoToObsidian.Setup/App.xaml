<Application x:Class="VideoToObsidian.Setup.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="BackgroundBrush" Color="#0C0D12" />
        <SolidColorBrush x:Key="CardBrush" Color="#171922" />
        <SolidColorBrush x:Key="MutedBrush" Color="#A7ACBC" />
        <SolidColorBrush x:Key="AccentBrush" Color="#8B5CF6" />
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="Margin" Value="0,6,10,6" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="Background" Value="#232632" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#353948" />
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="Background" Value="#232632" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#353948" />
        </Style>
    </Application.Resources>
</Application>
